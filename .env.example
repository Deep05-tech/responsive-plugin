# WordPress Staging Site Credentials
WP_BASE_URL=https://staging.example.com
WP_USER=era_agent
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OpenAI LLM Config
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Production Safety Guard (comma-separated domains or URLs)
# The agent will REFUSE to run against any matching target URL.
PRODUCTION_URL_BLOCKLIST=example.com,prod.example.com,https://myproduction.com

# Agent Execution Rules
ALLOW_HIDING=false
MAX_ITERATIONS=3
DESKTOP_DIFF_THRESHOLD=0.005
